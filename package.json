{
  "name": "@dihor/gamekit-board",
  "version": "0.1.0-preview.0",
  "description": "Reusable framework-agnostic board topology and piece movement toolkit for games and applications.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "typecheck:demo": "tsc -p tsconfig.demo.json --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PawelWielga/Dihor.GameKit.Board.git"
  },
  "bugs": {
    "url": "https://github.com/PawelWielga/Dihor.GameKit.Board/issues"
  },
  "homepage": "https://github.com/PawelWielga/Dihor.GameKit.Board#readme",
  "keywords": [
    "board",
    "board-game",
    "movement",
    "pieces",
    "grid",
    "graph",
    "typescript",
    "dihor",
    "gamekit",
    "games"
  ]
}
